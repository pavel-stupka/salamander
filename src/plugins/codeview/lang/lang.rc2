IDD_FIND DIALOGEX 0, 0, 240, 76
STYLE DS_SETFONT | DS_FIXEDSYS | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Find"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Find &text:", IDC_STATIC_1, 7, 9, 60, 8
    EDITTEXT        IDC_FIND_TEXT, 7, 21, 226, 12, ES_AUTOHSCROLL
    AUTOCHECKBOX    "Match &case", IDC_FIND_CASE, 7, 39, 100, 10
    AUTOCHECKBOX    "&Whole words only", IDC_FIND_WHOLEWORD, 7, 51, 100, 10
    DEFPUSHBUTTON   "Find &Next", IDOK, 128, 56, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 183, 56, 50, 14
END

IDD_GOTO DIALOGEX 0, 0, 200, 60
STYLE DS_SETFONT | DS_FIXEDSYS | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Go to Line"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Line number (or line:column):", IDC_STATIC_2, 7, 9, 186, 8
    EDITTEXT        IDC_GOTO_TEXT, 7, 21, 186, 12, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK", IDOK, 88, 40, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 143, 40, 50, 14
END

IDD_CFG DIALOGEX 0, 0, 300, 190
STYLE DS_SETFONT | DS_FIXEDSYS | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Code Viewer Configuration"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Font:", IDC_STATIC_3, 7, 9, 60, 8
    EDITTEXT        IDC_CFG_FONTNAME, 70, 7, 150, 12, ES_AUTOHSCROLL
    LTEXT           "Si&ze (0 = default):", IDC_STATIC_4, 7, 25, 60, 8
    EDITTEXT        IDC_CFG_FONTSIZE, 70, 23, 40, 12, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "&Tab width:", IDC_STATIC_5, 7, 41, 60, 8
    EDITTEXT        IDC_CFG_TABWIDTH, 70, 39, 40, 12, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "&Highlighting limit (KB):", IDC_STATIC_6, 7, 61, 90, 8
    EDITTEXT        IDC_CFG_HLLIMIT, 110, 59, 40, 12, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Larger files are shown as plain text.", IDC_STATIC_7, 155, 61, 138, 8
    LTEXT           "&Maximum line length:", IDC_STATIC_8, 7, 77, 90, 8
    EDITTEXT        IDC_CFG_MAXLINE, 110, 75, 40, 12, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Files with longer lines are shown as plain text.", IDC_STATIC_9, 155, 77, 138, 8
    LTEXT           "&Viewer limit (MB):", IDC_STATIC_10, 7, 93, 90, 8
    EDITTEXT        IDC_CFG_VIEWLIMIT, 110, 91, 40, 12, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Larger files open in the built-in viewer.", IDC_STATIC_11, 155, 93, 138, 8
    AUTOCHECKBOX    "&Keep the rendering engine ready for instant viewing", IDC_CFG_KEEPREADY, 7, 113, 286, 10
    LTEXT           "Files then open instantly after the first view in a session, at the cost of a small amount of memory held for the rest of the session.", IDC_STATIC_12, 18, 127, 275, 17
    PUSHBUTTON      "&Restore Default File Types", IDC_CFG_RESTORETYPES, 7, 150, 110, 14
    DEFPUSHBUTTON   "OK", IDOK, 188, 169, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 243, 169, 50, 14
END
