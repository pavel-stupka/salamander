IDD_FIND DIALOGEX 0, 0, 220, 60
STYLE DS_SETFONT | DS_FIXEDSYS | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Find"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Find &text:", IDC_STATIC_1, 7, 9, 60, 8
    EDITTEXT        IDC_FIND_TEXT, 7, 21, 206, 12, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "Find &Next", IDOK, 108, 40, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 163, 40, 50, 14
END

IDD_CFG DIALOGEX 0, 0, 270, 66
STYLE DS_SETFONT | DS_FIXEDSYS | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Markdown Viewer Configuration"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    AUTOCHECKBOX    "&Keep the rendering engine ready for instant viewing", IDC_CFG_KEEPREADY, 7, 9, 256, 10
    LTEXT           "Markdown files then open instantly after the first view in a session, at the cost of a small amount of memory held for the rest of the session.", IDC_STATIC_2, 18, 23, 245, 17
    DEFPUSHBUTTON   "OK", IDOK, 158, 45, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 213, 45, 50, 14
END
