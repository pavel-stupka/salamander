# yaml-language-server: $schema=https://aka.ms/winget-manifest.installer.1.10.0.schema.json
#
# Tandem Commander - winget installer manifest template.
# Generated into tools/winget/manifests/<version>/ by tools/winget/publish.ps1,
# which strips every comment except the schema line above - so authoring notes
# stay here and never reach the submitted manifest. Consequence: no line inside
# a block scalar may start with '#'.
# Placeholders: VERSION, SHA256, RELEASE_DATE
#
# ONE machine-scope installer, no switches - the canonical shape for an Inno
# Setup package in this catalogue, and deliberately minimal.
#
# A second Scope: user entry with Custom: /CURRENTUSER (and /ALLUSERS on the
# machine entry) was submitted first and FAILED check 08 Installation
# Validation on winget-pkgs#426038, label Validation-Shell-Execute. Inno Setup
# itself accepts the switches - that was verified - but the validation
# pipeline runs manifests elevated (winget-pkgs issue 72224), so a
# /CURRENTUSER install lands in the administrator's profile and is not found
# afterwards. Per-user support is worth having, but it needs to be proven in
# a Windows Sandbox first and added on its own, not folded into a submission
# that is also asking for a new package to be accepted.
#
# ProductCode is the uninstall registry key Inno Setup derives from AppId
# (setup/tandemcommander.iss line 10) as "<AppId>_is1". It is what lets winget
# recognise an already installed Tandem Commander for list/upgrade/uninstall.
# It must be kept in step with AppId; changing AppId breaks upgrade detection.

PackageIdentifier: PavelStupka.TandemCommander
PackageVersion: {{VERSION}}
Platform:
  - Windows.Desktop
MinimumOSVersion: 10.0.19041.0
InstallerType: inno
UpgradeBehavior: install
ReleaseDate: {{RELEASE_DATE}}
InstallModes:
  - interactive
  - silent
  - silentWithProgress
AppsAndFeaturesEntries:
  - DisplayName: Tandem Commander
    Publisher: Pavel Stupka
    DisplayVersion: {{VERSION}}
    ProductCode: '{35C0B0DC-DB73-429C-AAA8-FBC41C937F66}_is1'
Installers:
  # Per-machine install into Program Files, which is what the installer does on
  # its own: Inno Setup requires administrator rights by default and raises the
  # UAC prompt itself. No switch is passed for the scope, and no
  # ElevationRequirement is declared - winget handles an Inno installer's
  # elevation without being told.
  - Architecture: x64
    Scope: machine
    InstallerUrl: https://github.com/tandemcommander/tandemcommander/releases/download/v{{VERSION}}/tandemcommander-{{VERSION}}-x64-setup.exe
    InstallerSha256: {{SHA256}}
ManifestType: installer
ManifestVersion: 1.10.0
